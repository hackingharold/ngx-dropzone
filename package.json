{
  "name": "ngx-dropzone",
  "version": "",
  "private": true,
  "scripts": {
    "start:app": "ng serve app --host 0.0.0.0",
    "start:cdk": "ng build --watch --project=cdk",
    "build:cdk": "ng build cdk --configuration production",
    "test:cdk": "ng test cdk --no-watch --no-progress --browsers=ChromeHeadless",
    "test:cdk:dev": "CHROME_BIN=/usr/bin/chromium ng test cdk --no-watch --no-progress --browsers=ChromeHeadlessNoSandbox",
    "lint:cdk": "ng lint cdk",
    "start:material": "ng build --watch --project=material",
    "build:material": "ng build material --configuration production",
    "test:material": "ng test material --no-watch --no-progress --browsers=ChromeHeadless",
    "test:material:dev": "CHROME_BIN=/usr/bin/chromium ng test material --no-watch --no-progress --browsers=ChromeHeadlessNoSandbox",
    "lint:material": "ng lint material"
  },
  "dependencies": {
    "@angular/animations": "22.2.1",
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-browser-dynamic": "22.2.1",
    "@angular/router": "22.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "^7",
    "@types/node": "^26.6.4",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "6.3.0",
    "jsdom": "^30.1.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "ng-packagr": "^22.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
